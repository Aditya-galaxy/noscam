<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The installed-app check has to see every app to find the one that is
         spying. Google Play permits this for security apps whose core purpose
         is scanning installed apps; declare it in the Play Console as such. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- "Remove" hands the person to Android's own uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Say when a newly installed app can take the phone over. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the periodic install check scheduled across reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ hides other apps unless we say what we need to see: here,
         the browsers a checked link can be handed on to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="NoScam"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Every http/https link, with no host. Since Android 12 a tapped
                 link goes straight to the *default browser* unless an app has
                 verified that domain, so this filter alone is not enough: it is
                 what makes NoScam eligible to be chosen as the default browser
                 (RoleManager.ROLE_BROWSER). The app asks for that role on first
                 launch; once held, every tapped link comes here first and is
                 handed on to a real browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- Share → NoScam, which works without being the default. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Opened instead of the system installer when an app file is tapped
             in a chat, once chosen as the default for app files. -->
        <activity
            android:name=".ApkGuardActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AuditActivity"
            android:exported="false"
            android:label="Apps to check" />

        <service
            android:name=".InstallWatcherJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".NoScamDnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
