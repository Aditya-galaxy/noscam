{
  "manifest_version": 3,
  "name": "NoScam",
  "version": "1.1.0",
  "description": "Holds irreversible actions — payments, one-time codes, remote-access installs — when the instruction arrived through a message.",
  "permissions": ["webNavigation", "downloads", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "NoScam",
    "default_popup": "popup.html"
  },
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "offline_enabled": true,
  "browser_specific_settings": {
    "gecko": {
      "id": "guardian@noscam.org",
      "strict_min_version": "109.0"
    }
  }
}
